# Servidor
PUERTO=3000

# Base de datos PostgreSQL
DB_HOST=localhost
# 5433 por defecto para no chocar con un PostgreSQL nativo en 5432
DB_PUERTO=5433
DB_USUARIO=edutenant
DB_CLAVE=edutenant
DB_NOMBRE=edutenant

# JWT
JWT_SECRETO=cambia-este-secreto-en-produccion
JWT_EXPIRACION=8h

# Superadministrador inicial (sembrado opcional, ver módulo superadministrador)
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_CLAVE=superadmin123

# Correo (Resend) — recuperación de contraseña. Sin RESEND_API_KEY, el enlace
# se registra en el log del servidor en vez de enviarse (útil en desarrollo).
RESEND_API_KEY=
EMAIL_REMITENTE=Skolar <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
